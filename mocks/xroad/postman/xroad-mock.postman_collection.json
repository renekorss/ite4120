{
  "info": {
    "name": "Driving Licence Reminder — X-Road Mock",
    "description": "Local upstream licence-service mock only. All identities are synthetic. This does not describe the future frontend-facing API. Start the service using compose.mock.yaml. A separate Postman environment is not required.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:18081",
      "type": "string"
    },
    {
      "key": "servicePath",
      "value": "/r1/ee-test/GOV/70001490/liiklusregister/juhilubaKehtivus/v1",
      "type": "string"
    },
    {
      "key": "xRoadClient",
      "value": "ee-test/COM/00000000/licence-reminder-demo",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Valid licence",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Road-Client",
            "value": "{{xRoadClient}}"
          },
          {
            "key": "X-Road-Id",
            "value": "{{$guid}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isikukood\": \"00000000001\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}{{servicePath}}",
        "description": "Synthetic local scenario. Expected HTTP 200. No real X-Road request or database write."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response is marked as mock\", function () {",
              "  pm.expect(pm.response.headers.get(\"X-Mock-Service\")).to.eql(\"true\");",
              "});",
              "pm.test(\"Expected scenario result\", function () {",
              "  pm.expect(pm.response.json()[\"staatus\"]).to.eql(\"kehtiv\");",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
