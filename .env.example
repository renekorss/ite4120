# Local development only. Generate the ignored password file with scripts/init-local.sh.
POSTGRES_DB=licence_reminder
POSTGRES_USER=database_owner
POSTGRES_PASSWORD_FILE=./.secrets/postgres_password
POSTGRES_IMAGE=postgres:17.11-bookworm@sha256:3645570cccdfa447589da9f57dd740faa29b30938e861289a5574b6ca6b03826
LIQUIBASE_IMAGE=liquibase/liquibase:4.33.0@sha256:e116c935ba22b59a22165207f65c268e363269de30bb1fedacff3755c2abaa8c

# Optional frontend API settings. Host UID/GID are added to .env by init-local.sh.
API_HOST_PORT=18080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SESSION_SECONDS=1800
SESSION_WARNING_SECONDS=120
RISK_DAYS=90
STALE_SECONDS=86400
XROAD_TIMEOUT_SECONDS=3
PUSH_ALLOWED_HOSTS=push.example.test
OFFICIAL_RENEWAL_URL=https://eteenindus.mnt.ee/juht.jsf?lang=en
LOG_LEVEL=INFO

LOGIN_MAX_ATTEMPTS=5
LOGIN_SOURCE_MAX_ATTEMPTS=30
LOGIN_WINDOW_SECONDS=300

# init-local.sh records MOCK_MEDICAL_REFERENCE_DATE as a UTC YYYY-MM-DD date
# in the local .env on first setup to keep synthetic certificate deadlines stable.
