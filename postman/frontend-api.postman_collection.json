          "name": "07 Refresh driving data",
          "request": {
            "method": "POST",
            "url": "{{apiBaseUrl}}/api/v1/me/driving-data/refresh",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Successful check\", () => pm.expect(pm.response.json().check.outcome).to.eql(\"successful\"));",
                  "if (pm.response.code === 200) { pm.collectionVariables.set(\"checkId\", pm.response.json().check.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Recent status checks",
          "request": {
            "method": "GET",
            "url": "{{apiBaseUrl}}/api/v1/me/status-checks?limit=5",
            "header": []
