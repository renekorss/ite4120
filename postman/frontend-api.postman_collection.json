{
  "info": {
    "name": "Driving Licence Reminder — Frontend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Requests grouped by the OpenAPI documentation tags. Select the private seeded environment, send Authentication / 04 Login with seeded credentials once, then use any protected request: the saved collection accessToken is inherited automatically. Running the entire collection follows the numbered 24-step verification workflow across folders. Never export populated passwords or tokens."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "apiBaseUrl",
      "value": "http://127.0.0.1:18080",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "checkId",
      "value": "",
      "type": "string"
    },
    {
      "key": "subscriptionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Operations",
      "item": [
        {
          "name": "01 Health",
          "request": {
            "method": "GET",
            "url": "{{apiBaseUrl}}/health",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Configuration",
      "item": [
        {
          "name": "02 Frontend configuration",
          "request": {
            "method": "GET",
            "url": "{{apiBaseUrl}}/api/v1/config",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "04 Login with seeded credentials",
          "request": {
            "method": "POST",
            "url": "{{apiBaseUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{validUsername}}\",\n  \"password\": \"{{validPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { pm.collectionVariables.set(\"accessToken\", pm.response.json().accessToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "18 Logout",
          "request": {
            "method": "POST",
            "url": "{{apiBaseUrl}}/api/v1/auth/logout",
            "header": []
