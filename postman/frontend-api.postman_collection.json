          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "09 Specific status check",
          "request": {
            "method": "GET",
            "url": "{{apiBaseUrl}}/api/v1/me/status-checks/{{checkId}}",
            "header": []
