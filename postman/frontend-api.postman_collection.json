                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "21 Failed refresh preserves cached data",
          "request": {
            "method": "POST",
            "url": "{{apiBaseUrl}}/api/v1/me/driving-data/refresh",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Recorded upstream failure\", () => pm.expect(pm.response.json().check.outcome).to.eql(\"failed\"));",
                  "pm.test(\"Safe source error\", () => pm.expect(pm.response.json().check.error.code).to.eql(\"XR_UNAVAILABLE\"));"
                ]
              }
            }
          ]
        }
      ]
