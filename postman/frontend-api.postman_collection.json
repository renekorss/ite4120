  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Folder layout follows the API docs; Collection Runner follows the numbered workflow.",
          "// setNextRequest has no effect when sending individual requests manually.",
          "const workflow = [\"01 Health\", \"02 Frontend configuration\", \"03 Protected profile requires authentication\", \"04 Login with seeded credentials\", \"05 My profile\", \"06 My driving data\", \"07 Refresh driving data\", \"08 Recent status checks\", \"09 Specific status check\", \"10 Renewal guidance\", \"11 Current reminder preferences\", \"12 Enable or edit reminders\", \"13 Reject unsupported interval\", \"14 Disable reminders\", \"15 Previous sent notifications\", \"16 Register synthetic browser subscription\", \"17 Revoke browser subscription\", \"18 Logout\", \"19 Revoked session cannot read profile\", \"20 Login unavailable-source demo\", \"21 Failed refresh preserves cached data\", \"22 Logout unavailable-source demo\", \"23 Invalid password login\", \"24 Reject unlisted demo code\"];",
          "const index = workflow.indexOf(pm.info.requestName);",
          "if (index !== -1) {",
          "  pm.execution.setNextRequest(workflow[index + 1] || null);",
          "}"
        ]
      }
    }
  ]
}
