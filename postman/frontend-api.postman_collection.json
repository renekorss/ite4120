            "body": {
              "mode": "raw",
              "raw": "{\n  \"endpoint\": \"https://push.example.test/postman-demo\",\n  \"keys\": {\n    \"p256dh\": \"BA_aa5LDbsy2ROsVmCcx-UydrUar8mIBrXJCe9SVbcfyMakvlXmaBHz8kkIDQJCORZSqHD40GcYV0De4o0YvoYI\",\n    \"auth\": \"bW9jay1hdXRoLXNlY3JldA\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
