                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "23 Invalid password login",
          "request": {
            "method": "POST",
            "url": "{{apiBaseUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"does.not.exist\",\n  \"password\": \"intentionally-incorrect\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "24 Reject unlisted demo code",
          "request": {
            "method": "POST",
            "url": "{{apiBaseUrl}}/api/v1/auth/demo-login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"personalCode\":\"00000000000\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "The password-only stack hides this route (404). The local web demo rejects unlisted codes (401)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Demo login rejects this request', () => pm.expect(pm.response.code).to.be.oneOf([401, 404]));"
                ]
              }
            }
          ]
        }
      ]
    },
