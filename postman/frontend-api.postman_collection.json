          "name": "20 Login unavailable-source demo",
          "request": {
            "method": "POST",
            "url": "{{apiBaseUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{unavailableUsername}}\",\n  \"password\": \"{{unavailablePassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { pm.collectionVariables.set(\"accessToken\", pm.response.json().accessToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "22 Logout unavailable-source demo",
          "request": {
            "method": "POST",
            "url": "{{apiBaseUrl}}/api/v1/auth/logout",
            "header": []
